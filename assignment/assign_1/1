module dynamic;
  int d1[];
  int d[];
  int i;
  initial begin
    d='{9,1,8,3,4,4};
    d1=new[6];
    for(i=0;i<d1.size();i++)begin
      d1[i]=i;
    end
     for(i=0;i<d1.size();i++)begin
       $display("d1[%0d]=%0d",i,d1[i]);
    end
    $display("d1=%p",d1);
    $display("size of d1=%0d",d1.size());
    d1.delete;
    $display("d1=%p",d1);
    d.reverse();
    $display("d=%p",d);
    d.sort();
    $display("d=%p",d);
    d.rsort();
    $display("d=%p",d);
    d.shuffle();
    $display("d=%p",d);
  end
endmodule
    
    

